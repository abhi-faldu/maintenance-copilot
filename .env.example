# Qdrant: an http(s) URL, ":memory:", or a local folder path (embedded mode, no Docker needed)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=manuals

# Embeddings: "bge-m3" (real, needs `uv sync --extra embed`) or "hash" (offline, lexical-only smoke tests)
EMBED_BACKEND=bge-m3
EMBED_MODEL=BAAI/bge-m3

# Chunking
CHUNK_MAX_CHARS=1500

# LLM (week 3)
LLM_BACKEND=ollama
